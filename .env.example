# Copy this file to .env and fill in real values. .env is gitignored.

# MySQL — must match the DB name hardcoded in db/schema.sql (it does
# `CREATE DATABASE ecommerce_db`), so don't change this without also
# updating db/schema.sql.
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=ecommerce_db

# Host port mappings — chosen to avoid clashing with services already
# running locally (a local MySQL on 3306, and something on 8080).
MYSQL_HOST_PORT=3307
API_HOST_PORT=8081
